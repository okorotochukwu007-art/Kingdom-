# GEMINI_API_KEY: Required for Gemini AI API calls (content classification & recommendation rationales).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: Official YouTube Data API v3 key from Google Cloud Console.
# Used server-side for Nigerian-first channel syncing, video statistics, and discovery searches.
YOUTUBE_API_KEY="YOUR_YOUTUBE_DATA_API_V3_KEY"

# SUPABASE CONFIGURATION: Your external Supabase PostgreSQL, Auth & Realtime project credentials.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ADMIN_EMAIL: Email address automatically granted super_admin privileges upon registration.
ADMIN_EMAIL="okorotochukwu007@gmail.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
